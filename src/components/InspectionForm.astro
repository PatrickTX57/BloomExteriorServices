---
export interface Props {
  variant?: 'top' | 'bottom';
}
const { variant = 'top' } = Astro.props;

// Web3Forms \u2014 free form backend, no account dashboard needed beyond the
// access key. Key lives in PUBLIC_WEB3FORMS_ACCESS_KEY (Netlify env vars /
// .env) rather than hardcoded, so it can be rotated without a code change.
// Falls back to a mailto link if that env var isn't set, so the form never
// silently fails.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const fallbackMailto = 'mailto:patricksweeneybiz@gmail.com?subject=Free%20Inspection%20Request';
const formId = `inspection-form-${variant}`;
---
<section class={`inspection-form inspection-form--${variant}`}>
  <div class="inspection-form__inner">
    <p class="inspection-form__eyebrow">Free, No-Obligation Inspection &amp; Estimate</p>

    <form
      id={formId}
      class="inspection-form__form"
      action={accessKey ? 'https://api.web3forms.com/submit' : fallbackMailto}
      method="POST"
    >
      {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
      {accessKey && <input type="hidden" name="subject" value="New Free Inspection Request \u2014 Bloom Exterior Services" />}
      {accessKey && <input type="hidden" name="from_name" value="Bloom Exterior Services Website" />}

      <div class="inspection-form__fields">
        <label class="sr-only" for={`${formId}-first`}>First Name</label>
        <input id={`${formId}-first`} type="text" name="First Name" placeholder="First Name" required autocomplete="given-name" />

        <label class="sr-only" for={`${formId}-last`}>Last Name</label>
        <input id={`${formId}-last`} type="text" name="Last Name" placeholder="Last Name" required autocomplete="family-name" />

        <label class="sr-only" for={`${formId}-email`}>Email</label>
        <input id={`${formId}-email`} type="email" name="email" placeholder="Email" required autocomplete="email" />

        <label class="sr-only" for={`${formId}-phone`}>Phone</label>
        <input id={`${formId}-phone`} type="tel" name="Phone" placeholder="Phone" required autocomplete="tel" />
      </div>
      <div class="h-captcha" data-captcha="true" data-size="compact"></div>
      <button type="submit" class="btn inspection-form__submit">Get My Free Estimate</button>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('.inspection-form__form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const hCaptcha = form.querySelector('textarea[name="h-captcha-response"]');
      if (!hCaptcha || !(hCaptcha as HTMLTextAreaElement).value) {
        e.preventDefault();
        alert('Please complete the captcha to submit the form.');
      }
    });
  });
</script>

<style>
  .inspection-form {
    padding: 1.25rem 2rem;
  }
  .inspection-form--top {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }
  .inspection-form--bottom {
    background: var(--color-navy);
  }
  .inspection-form--bottom .inspection-form__eyebrow {
    color: #ffffff;
  }
  .inspection-form__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .inspection-form__eyebrow {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-navy);
    white-space: nowrap;
  }
  .inspection-form__form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
  }
  .inspection-form__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    flex: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .inspection-form input {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #ffffff;
    min-width: 140px;
    flex: 1 1 150px;
  }
  .inspection-form input:focus {
    outline: 2px solid var(--color-green);
    outline-offset: 1px;
  }
  .inspection-form__submit {
    white-space: nowrap;
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
  }
  @media (max-width: 860px) {
    .inspection-form__inner {
      flex-direction: column;
      align-items: stretch;
    }
    .inspection-form__fields {
      flex-direction: column;
    }
    .inspection-form input {
      width: 100%;
    }
    .inspection-form__submit {
      width: 100%;
    }
  }
</style>
