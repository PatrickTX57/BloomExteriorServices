---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { irrigationCities } from '../../data/irrigationCities';

export function getStaticPaths() {
  return irrigationCities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: (typeof irrigationCities)[number] };
const otherCities = irrigationCities.filter((c) => c.slug !== city.slug);

const services = [
  { icon: '\u{1F4A7}', title: 'Sprinkler System Installation', desc: 'New sprinkler systems designed and installed with zones matched to sun exposure, slope, and soil type.' },
  { icon: '\u{1F527}', title: 'Sprinkler Repair & Tune-Ups', desc: 'Fixing broken heads, leaks, and misaligned zones, plus seasonal tune-ups that catch problems early.' },
  { icon: '\u{1F6B0}', title: 'Drip Irrigation', desc: 'Efficient drip systems for flower beds, shrubs, and gardens that deliver water directly to the root zone.' },
  { icon: '\u2699\uFE0F', title: 'Smart Controllers', desc: 'Smart irrigation controllers that adjust watering automatically by season, cutting water waste.' },
];

const faqs = [
  {
    q: `Do you install and repair sprinkler systems in ${city.name}?`,
    a: `Yes. We install new sprinkler systems, repair existing ones, and run seasonal tune-ups for homes throughout ${city.name} and the surrounding ${city.region} area.`,
  },
  {
    q: 'How much does a sprinkler system cost?',
    a: 'Cost depends on your yard\u2019s size, the number of zones needed, and your soil and slope conditions. We provide a free, no-obligation estimate after an on-site consultation.',
  },
  {
    q: 'Do you offer drip irrigation for flower beds?',
    a: 'Yes \u2014 we design drip irrigation zones for beds, shrubs, and gardens that run alongside or independent of your turf sprinkler zones.',
  },
];
---
<BaseLayout
  title={`Sprinkler & Irrigation Systems in ${city.name}, TX | Bloom Exterior Services`}
  description={`Sprinkler system installation, repair, and drip irrigation for homes in ${city.name}, TX. Free estimates from Bloom Exterior Services.`}
>
  <div class="irrigation-hero">
    <div class="eyebrow">{city.region}</div>
    <h1>Sprinkler &amp; Irrigation Systems in {city.name}, TX</h1>
    <p>{city.intro}</p>
    <div class="btn-row">
      <a href="/contact" class="btn">Get a Free Estimate</a>
      <a href="tel:4697591171" class="btn-outline">Call (469) 759-1171</a>
    </div>
  </div>

  <section>
    <div class="section-head">
      <div class="eyebrow">What We Install</div>
      <h2>Irrigation Services in {city.name}</h2>
    </div>
    <div class="services-grid">
      {services.map((s) => (
        <div class="service-card">
          <div class="service-icon">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {city.zips.length > 0 && (
    <section>
      <div class="section-head">
        <div class="eyebrow">Where We Work</div>
        <h2>ZIP Codes We Serve in {city.name}</h2>
      </div>
      <ul class="bloom-list zip-list">
        {city.zips.map((z) => <li>{z}</li>)}
      </ul>
    </section>
  )}

  <section>
    <div class="section-head">
      <div class="eyebrow">FAQ</div>
      <h2>Common Questions from {city.name} Homeowners</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="cta-banner">
    <h2>Ready for a Healthier Lawn in {city.name}?</h2>
    <p>Get a free, no-obligation irrigation estimate from the Bloom Exterior Services team.</p>
    <a href="/contact" class="btn cta-btn">Request a Free Quote</a>
  </div>

  <section class="other-cities">
    <div class="section-head">
      <div class="eyebrow">Service Area</div>
      <h2>Other DFW Communities We Serve</h2>
    </div>
    <div class="city-links">
      {otherCities.map((c) => (
        <a href={`/irrigation/${c.slug}/`} class="city-link">{c.name}</a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .irrigation-hero {
    text-align: center;
    max-width: 720px;
    margin: 3rem auto 3.5rem;
  }
  .eyebrow {
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .irrigation-hero h1 {
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .irrigation-hero p {
    color: var(--color-text-muted);
    font-size: 17px;
    margin-bottom: 28px;
  }
  .btn-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  section {
    padding: 60px 0;
  }
  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 40px;
  }
  .section-head h2 {
    font-size: 28px;
    font-weight: 800;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .service-card {
    background: var(--color-bg-alt);
    border-radius: 10px;
    padding: 26px 22px;
    border: 1px solid var(--color-border);
  }
  .service-icon {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 14px;
  }
  .service-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
    font-weight: 700;
  }
  .service-card p {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .zip-list {
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 32px;
  }
  .zip-list li {
    font-weight: 600;
    color: var(--color-navy);
    width: auto;
    padding-left: 26px;
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }
  .faq-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }
  .faq-item p {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .cta-banner {
    background: var(--color-green);
    color: #fff;
    text-align: center;
    padding: 50px 24px;
    margin: 0 -24px;
    border-radius: 12px;
  }
  .cta-banner h2 {
    font-size: 26px;
    font-weight: 800;
    margin-bottom: 12px;
    color: #fff;
  }
  .cta-banner p {
    margin-bottom: 22px;
    color: #e6f4ea;
  }
  .cta-btn {
    background: var(--color-navy);
  }
  .cta-btn:hover {
    background: var(--color-navy-dark);
  }

  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .city-link {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-navy);
    padding: 8px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .city-link:hover {
    border-color: var(--color-green-light);
    color: var(--color-green);
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .irrigation-hero h1 {
      font-size: 28px;
    }
  }
</style>
