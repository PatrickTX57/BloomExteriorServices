---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { irrigationCities } from '../../data/irrigationCities';
---
<BaseLayout
  title="Sprinkler & Irrigation Systems | DFW Metro | Bloom Exterior Services"
  description="Bloom Exterior Services installs and repairs sprinkler systems and drip irrigation for homes across the DFW metro. Find your city below for local details and a free estimate."
>
  <div class="section-head">
    <div class="eyebrow">Irrigation</div>
    <h1>Sprinkler &amp; Irrigation Systems, Installed Locally</h1>
    <p>We design, install, and repair sprinkler systems and drip irrigation for homes throughout the DFW metro. Choose your city below for local details, or request a free estimate any time.</p>
  </div>
  <div class="city-grid">
    {irrigationCities.map((city) => (
      <a class="city-card" href={`/irrigation/${city.slug}/`}>
        <span class="city-region">{city.region}</span>
        <h2>{city.name}</h2>
        <p>{city.intro.slice(0, 120)}&hellip;</p>
        <span class="city-link-text">View {city.name} irrigation &rarr;</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 3rem auto 3rem;
  }
  .eyebrow {
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .section-head p {
    color: var(--color-text-muted);
    font-size: 16px;
  }
  .city-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 4rem;
  }
  .city-card {
    background: var(--color-bg-alt);
    border-radius: 10px;
    padding: 26px 24px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .city-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(15, 42, 74, 0.1);
    border-color: var(--color-green-light);
  }
  .city-region {
    display: inline-block;
    background: var(--color-navy);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .city-card h2 {
    font-size: 19px;
    margin: 0 0 8px;
    font-weight: 700;
  }
  .city-card p {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 0 0 12px;
  }
  .city-link-text {
    color: var(--color-green);
    font-weight: 600;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .city-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
