---
import { getCollection, render } from 'astro:content';
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityEnabled, getAllBlogPosts } from '../../lib/sanity';

export async function getStaticPaths() {
  if (sanityEnabled) {
    const sanityPosts = await getAllBlogPosts();
    return sanityPosts.map((post) => ({ params: { id: post.slug.current }, props: { sanityPost: post } }));
  }
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post, sanityPost } = Astro.props as any;
const Content = post ? (await render(post)).Content : null;

const title = sanityPost ? (sanityPost.seoTitle || sanityPost.title) : post.data.title;
const description = sanityPost ? sanityPost.excerpt : post.data.description;
const category = sanityPost ? sanityPost.category : post.data.category;
const pubDate = new Date(sanityPost ? sanityPost.publishedAt : post.data.pubDate);
---
<BaseLayout title={`${title} | Bloom Exterior Services`} description={description}>
  <article class="post">
    <div class="post-header">
      {category && <span class="post-category">{category}</span>}
      <h1>{title}</h1>
      <p class="post-date">{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </div>
    <div class="post-body">
      {sanityPost ? <PortableText value={sanityPost.body} /> : <Content />}
    </div>
    <a class="btn back-link" href="/blog">&larr; Back to Blog</a>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 0 4rem;
  }
  .post-header {
    margin-bottom: 2rem;
  }
  .post-category {
    display: inline-block;
    background: var(--color-navy);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .post-header h1 {
    margin: 0 0 10px;
  }
  .post-date {
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }
  .post-body {
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }
  .post-body h2 {
    margin-top: 2rem;
  }
  .post-body p {
    margin-bottom: 1.25rem;
  }
  .post-body ul,
  .post-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .back-link {
    margin-top: 2.5rem;
  }
</style>
