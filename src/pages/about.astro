---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About Us | Bloom Exterior Services"
  description="Bloom Exterior Services is a Plano, TX-based team dedicated to helping homeowners across the DFW metro protect and beautify their properties."
>
  <section class="about-page">
    <div class="about-photo" role="img" aria-label="Bloom Exterior Services crew completing a siding project in Plano, TX">[ Photo of crew / completed project ]</div>
    <div>
      <div class="eyebrow">Why Homeowners Choose Us</div>
      <h1>Local, Licensed, and Focused on the Details</h1>
      <p>Bloom Exterior Services is a Plano-based team dedicated to helping homeowners across DFW protect and beautify their properties. We show up on time, communicate clearly, and stand behind every project.</p>
      <p>From a single afternoon of pressure washing to a full siding replacement, our crews treat every home like it's their own — clean job sites, honest timelines, and no surprises on the invoice.</p>
      <ul class="about-list">
        <li><span class="check">✓</span> Licensed &amp; fully insured crews</li>
        <li><span class="check">✓</span> Free, no-pressure estimates</li>
        <li><span class="check">✓</span> Written warranty on all work</li>
        <li><span class="check">✓</span> Local team, fast response times</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding: 3rem 0 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .eyebrow {
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .about-list {
    list-style: none;
    margin-top: 20px;
    padding: 0;
  }
  .about-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    font-weight: 600;
  }
  .check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-green);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    flex-shrink: 0;
  }
  .about-photo {
    background: linear-gradient(135deg, var(--color-green), var(--color-navy-dark));
    border-radius: 12px;
    height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    padding: 20px;
  }
  @media (max-width: 900px) {
    .about-page {
      grid-template-columns: 1fr;
    }
    .about-photo {
      height: 220px;
    }
  }
</style>
