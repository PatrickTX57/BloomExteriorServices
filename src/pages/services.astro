---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { icon: '\u{1F333}', title: 'Landscape', desc: 'Full landscape design and installation \u2014 beds, mulch, plantings, and clean lines that boost curb appeal year-round.' },
  { icon: '\u{1F4A7}', title: 'Sprinklers', desc: "Sprinkler system installation, repair, and seasonal tune-ups that keep your lawn healthy without wasting water.", link: '/irrigation/', linkText: 'See irrigation by city' },
  { icon: '\u{1F6B0}', title: 'Drip Systems', desc: "Efficient drip irrigation for flower beds, shrubs, and gardens that delivers water exactly where it's needed.", link: '/irrigation/', linkText: 'See irrigation by city' },
  { icon: '\u{1F30A}', title: 'Underground Drainage', desc: 'Underground drainage solutions that move water away from your home and yard before it becomes a problem.' },
  { icon: '\u{1FAA8}', title: 'French Drains', desc: 'French drain installation to redirect groundwater and keep low spots in your yard from flooding after storms.' },
  { icon: '\u{1F9F1}', title: 'Hardscape', desc: 'Patios, walkways, and retaining walls built with quality materials that stand up to Texas weather.' },
  { icon: '\u{1F4A1}', title: 'Permanent and Holiday Lighting', desc: 'Permanent architectural lighting and holiday lighting installation \u2014 set the mood year-round or just for the season.', link: '/lighting/', linkText: 'See lighting by city' },
];
---
<BaseLayout
  title="Exterior Services | Bloom Exterior Services"
  description="Landscape, sprinklers, drip systems, underground drainage, French drains, hardscape, and permanent/holiday lighting for homeowners in Plano, Frisco, Allen, McKinney, and the DFW metro."
>
  <div class="section-head">
    <div class="eyebrow">What We Do</div>
    <h1>Exterior Services Built to Last</h1>
    <p>From a full landscape refresh to a French drain that finally solves your drainage headache, our licensed and insured crews handle every job with care.</p>
  </div>
  <div class="services-grid">
    {services.map((s) => (
      <div class="service-card">
        <div class="service-icon">{s.icon}</div>
        <h2>{s.title}</h2>
        <p>{s.desc}</p>
        {s.link && <a href={s.link} class="service-card-link">{s.linkText} &rarr;</a>}
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 3rem auto 3rem;
  }
  .eyebrow {
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-bottom: 4rem;
  }
  .service-card {
    background: var(--color-bg-alt);
    border-radius: 10px;
    padding: 32px 26px;
    border: 1px solid var(--color-border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(15, 42, 74, 0.1);
    border-color: var(--color-green-light);
  }
  .service-icon {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: var(--color-navy);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 18px;
  }
  .service-card h2 {
    font-size: 19px;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .service-card p {
    color: var(--color-text-muted);
    font-size: 15px;
  }
  .service-card-link {
    display: inline-block;
    margin-top: 14px;
    font-weight: 700;
    font-size: 14px;
    color: var(--color-green);
    text-decoration: none;
  }
  .service-card-link:hover {
    color: var(--color-green-light);
  }
  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
