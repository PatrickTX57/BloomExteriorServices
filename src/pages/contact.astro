---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Us | Bloom Exterior Services"
  description="Get in touch with Bloom Exterior Services for a free, no-obligation estimate. Serving Plano, Frisco, Allen, McKinney, and the DFW metro."
>
  <div class="contact-wrap">
    <div class="contact-info">
      <div class="eyebrow">Contact Us</div>
      <h1>Let's Talk About Your Project</h1>
      <p>Reach out by phone or email and we'll get back to you within one business day. You can also use the signup popup on this site to join our list and get updates.</p>
      <div class="info-row">
        <div class="info-icon">📍</div>
        <div><strong>Address</strong><span>1600 W Plano Pkwy, STE 9<br />Plano, TX 75075</span></div>
      </div>
      <div class="info-row">
        <div class="info-icon">📞</div>
        <div><strong>Phone</strong><a href="tel:4697591171">(469) 759-1171</a></div>
      </div>
      <div class="info-row">
        <div class="info-icon">✉️</div>
        <div><strong>Email</strong><a href="mailto:info@bloomexteriorservices.com">info@bloomexteriorservices.com</a></div>
      </div>
      <div class="info-row">
        <div class="info-icon">🕒</div>
        <div><strong>Hours</strong><span>Mon–Fri: 8:00 AM – 6:00 PM<br />Sat: 9:00 AM – 2:00 PM</span></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-wrap {
    padding: 3rem 0 4rem;
    max-width: 560px;
  }
  .eyebrow {
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .contact-info p {
    color: var(--color-text-muted);
    margin-bottom: 28px;
  }
  .info-row {
    display: flex;
    gap: 16px;
    margin-bottom: 22px;
    align-items: flex-start;
  }
  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--color-bg-alt);
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .info-row strong {
    display: block;
    color: var(--color-navy);
    font-size: 15px;
  }
  .info-row span,
  .info-row a {
    color: var(--color-text-muted);
    font-size: 14px;
    text-decoration: none;
  }
  .info-row a:hover {
    color: var(--color-green);
  }
</style>
